<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
  <sharingCriteriaRules>
    <fullName>CriteriaSharingRuleSwapJuly</fullName>
    <accessLevel>Read</accessLevel>
    <label>CriteriaSharingRuleSwapJuly</label>
    <sharedTo>
      <allInternalUsers/>
    </sharedTo>
    <criteriaItems>
      <field>Company</field>
      <operation>equals</operation>
      <value>Opsera</value>
    </criteriaItems>
    <criteriaItems>
      <field>Country</field>
      <operation>contains</operation>
      <value>India</value>
    </criteriaItems>
    <criteriaItems>
      <field>City</field>
      <operation>startsWith</operation>
      <value>Pune</value>
    </criteriaItems>
    <criteriaItems>
      <field>Status</field>
      <operation>equals</operation>
      <value>Open,Working,Assigned</value>
    </criteriaItems>
    <criteriaItems>
      <field>FirstName</field>
      <operation>notContain</operation>
      <value>ABC</value>
    </criteriaItems>
    <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
  </sharingCriteriaRules>
  <sharingCriteriaRules>
    <fullName>HubSpot_Integration</fullName>
    <accessLevel>Edit</accessLevel>
    <description>enables Leads that meet criteria to sync with HS</description>
    <label>HubSpot Integration</label>
    <sharedTo>
      <role>Integrations</role>
    </sharedTo>
    <criteriaItems>
      <field>Email</field>
      <operation>contains</operation>
      <value>@</value>
    </criteriaItems>
    <criteriaItems>
      <field>Sync_to_HubSpot__c</field>
      <operation>equals</operation>
      <value>True</value>
    </criteriaItems>
    <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
  </sharingCriteriaRules>
  <sharingOwnerRules>
    <fullName>CriteriaSharingRuleSwap</fullName>
    <accessLevel>Read</accessLevel>
    <label>CriteriaSharingRuleSwap</label>
    <sharedTo>
      <group>Admins</group>
    </sharedTo>
    <sharedFrom>
      <group>Admins</group>
    </sharedFrom>
  </sharingOwnerRules>
  <sharingOwnerRules>
    <fullName>CriteriaSharingRuleSwapJuly2</fullName>
    <accessLevel>Read</accessLevel>
    <label>CriteriaSharingRuleSwapJuly2</label>
    <sharedTo>
      <role>Customer_Success</role>
    </sharedTo>
    <sharedFrom>
      <group>Admins</group>
    </sharedFrom>
  </sharingOwnerRules>
  <sharingOwnerRules>
    <fullName>Lead_sharing</fullName>
    <accessLevel>Edit</accessLevel>
    <description>Test</description>
    <label>Lead sharing</label>
    <sharedTo>
      <roleAndSubordinatesInternal>Global</roleAndSubordinatesInternal>
    </sharedTo>
    <sharedFrom>
      <roleAndSubordinatesInternal>Global</roleAndSubordinatesInternal>
    </sharedFrom>
  </sharingOwnerRules>
</SharingRules>
